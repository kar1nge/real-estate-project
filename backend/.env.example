# Copy to .env for local use. Replace every placeholder; do not commit .env.
DJANGO_ENV=development
DJANGO_DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=real_estate
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CMS_LOGIN_THROTTLE_RATE=5/minute
INQUIRY_THROTTLE_RATE=10/hour
SITE_VISIT_THROTTLE_RATE=10/hour

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

COMPANY_NAME=Saif Properties
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_WHATSAPP=
COMPANY_GOOGLE_MAPS=
COMPANY_ADDRESS=
COMPANY_INSTAGRAM=
COMPANY_FACEBOOK=
COMPANY_TWITTER=
COMPANY_TIKTOK=
COMPANY_YOUTUBE=
